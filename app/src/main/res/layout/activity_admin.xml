<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/lightGreen">

    <TextView
        android:id="@+id/adminWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Welcome Admin 👨‍💼"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        tools:text="Welcome Admin" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/adminWelcome"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/addProductBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/green_bg"
                android:text="@string/add_product"
                android:textColor="@color/white"
                style="@style/Widget.AppCompat.Button.Colored" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/manageStockBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/green_bg"
                android:text="@string/manage_stock"
                android:textColor="@color/white"
                style="@style/Widget.AppCompat.Button.Colored" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/viewOrdersBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/green_bg"
                android:text="@string/view_orders"
                android:textColor="@color/white"
                style="@style/Widget.AppCompat.Button.Colored"
                tools:ignore="DuplicateIds" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/manageAdminsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/green_bg"
                android:text="@string/manage_admins"
                android:textColor="@color/white"
                android:visibility="gone"
                style="@style/Widget.AppCompat.Button.Colored" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/logoutAdminBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/red_bg"
                android:text="@string/logout"
                android:textColor="@color/white"
                style="@style/Widget.AppCompat.Button.Colored" />

        </LinearLayout>
    </ScrollView>



    </androidx.constraintlayout.widget.ConstraintLayout>

