<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".BloodBudApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BloodBud"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Login Activity -->
        <activity
            android:name=".Activity.AccountActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name="com.example.blood_bud.Activity.AppointmentsActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Donor Dashboard Activity -->
        <activity
            android:name=".ui.donor.DonorDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Edit Donor Profile Activity -->
        <activity
            android:name=".Activity.EditDonorProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Intro Activity (Launcher) -->
        <activity
            android:name=".Activity.IntroActivity"
            android:exported="true"
            android:theme="@style/Theme.BloodBud.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            
        <!-- Hospital Profile Activity -->
        <activity
            android:name=".Activity.HospitalProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Registration Type Selection Activity (Entry point for registration) -->
        <activity
            android:name=".Activity.RegistrationTypeActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Donor Registration Activity -->
        <activity
            android:name=".Activity.DonorRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Hospital Registration Activity -->
        <activity
            android:name=".Activity.HospitalRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Hospital Dashboard Activity -->
        <activity
            android:name=".Activity.HospitalDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Hospital History Activity -->
        <activity
            android:name=".Activity.HospitalHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Manage Stock Activity -->
        <activity
            android:name=".Activity.ManageStockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".Activity.DonorDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <!-- Admin Activities -->
        <activity
            android:name=".ui.admin.ManageUsersActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".ui.admin.ViewDonationsActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".ui.admin.ManageHospitalsActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".ui.admin.ViewAnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <activity
            android:name=".ui.admin.ManageAdminsActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".Activity.AddAppointmentSlotActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".Activity.AppointmentSchedulingActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.BloodBud.NoActionBar" />
            
        <!-- Legacy Registration Activity (Kept for reference, can be removed later) -->
        <activity
            android:name=".Activity.RegistrationActivity"
            android:exported="false"
            android:enabled="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BloodBud.NoActionBar"
            tools:node="remove" />

    </application>

</manifest>